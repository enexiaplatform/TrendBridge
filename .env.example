# Public Supabase project configuration. Never expose a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Server-only. Use trendbridge with the isolated bootstrap; public for legacy installs.
SUPABASE_RESEARCH_SCHEMA=public

# Optional evidence providers. Empty means the relevant module is unavailable.
SEARCH_PROVIDER=disabled
SEARCH_API_KEY=
RESEARCH_PROVIDER=disabled
# Manus transport is dormant. Do not activate until the live pilot passes.
MANUS_API_KEY=
MANUS_LIVE_ENABLED=false
# Pilot operator: confirmed Supabase Auth email OR user UUID. Email must match a real signed-in, confirmed account.
MANUS_PILOT_OWNER_ID=
# Optional exact HTTPS callback URL, only for registered signed webhook.
MANUS_WEBHOOK_URL=

# Payment adapter. Webhook fulfillment stays disabled until all values exist.
PAYMENT_PROVIDER=disabled
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

APP_URL=http://localhost:3000
